{
  "expo": {
    "name": "PedalPass",
    "slug": "pedalpass-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f2f3f5",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dyci.pedalpass"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B2984",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dyci.pedalpass"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "PedalPass uses the camera to scan the QR code on campus bicycles.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "PedalPass uses the camera to photograph your school ID, COR and a selfie for identity verification.",
          "photosPermission": "PedalPass lets you choose a photo of your school ID or COR for identity verification."
        }
      ]
    ]
  }
}