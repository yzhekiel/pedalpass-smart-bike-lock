# Copy this file to .env.local and fill in the values from
# Supabase dashboard → Connect button (Project URL) and Project Settings → API Keys
# (Publishable key, sb_publishable_...). NEVER put the secret key (sb_secret_...) here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
